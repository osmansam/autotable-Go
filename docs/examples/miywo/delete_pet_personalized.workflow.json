{
  "name": "delete_pet_personalized",
  "trigger": "manual",
  "mode": "transactional",
  "isActive": true,
  "isAuthenticated": true,
  "isAuthorized": false,
  "authorizeRole": [],
  "conditions": [],
  "steps": [
    {
      "name": "guard_pet_id",
      "type": "if",
      "order": 1,
      "isActive": true,
      "conditions": [
        {
          "field": "record.petId",
          "operator": "is_empty"
        }
      ],
      "steps": [
        {
          "name": "pet_id_required",
          "type": "fail",
          "order": 1,
          "isActive": true,
          "config": {
            "message": "petId is required",
            "status": 400
          }
        }
      ]
    },
    {
      "name": "pet",
      "type": "find_records",
      "order": 2,
      "isActive": true,
      "targetSchema": "pets",
      "config": {
        "filter": {
          "_id": "{{record.petId}}"
        },
        "limit": 1
      }
    },
    {
      "name": "guard_pet",
      "type": "if",
      "order": 3,
      "isActive": true,
      "conditions": [
        {
          "field": "steps.pet.count",
          "operator": "=",
          "value": 0
        }
      ],
      "steps": [
        {
          "name": "pet_not_found_before_authorization",
          "type": "fail",
          "order": 1,
          "isActive": true,
          "config": {
            "message": "Pet not found",
            "status": 404
          }
        }
      ]
    },
    {
      "name": "current_profile",
      "type": "find_records",
      "order": 4,
      "isActive": true,
      "targetSchema": "profiles",
      "config": {
        "filter": {
          "_id": "{{steps.pet.items.0.owner_user_id}}",
          "auth_id": "{{user._id}}"
        },
        "limit": 1
      }
    },
    {
      "name": "guard_profile",
      "type": "if",
      "order": 5,
      "isActive": true,
      "conditions": [
        {
          "field": "steps.current_profile.count",
          "operator": "=",
          "value": 0
        }
      ],
      "steps": [
        {
          "name": "profile_not_found",
          "type": "fail",
          "order": 1,
          "isActive": true,
          "config": {
            "message": "Pet not found",
            "status": 404
          }
        }
      ]
    },
    {
      "name": "delete_pet",
      "type": "delete_record",
      "order": 6,
      "isActive": true,
      "targetSchema": "pets",
      "config": {
        "filter": {
          "_id": "{{record.petId}}",
          "owner_user_id": "{{steps.pet.items.0.owner_user_id}}"
        }
      }
    },
    {
      "name": "guard_deleted",
      "type": "if",
      "order": 7,
      "isActive": true,
      "conditions": [
        {
          "field": "steps.delete_pet.deletedCount",
          "operator": "=",
          "value": 0
        }
      ],
      "steps": [
        {
          "name": "pet_not_deleted",
          "type": "fail",
          "order": 1,
          "isActive": true,
          "config": {
            "message": "Pet not found",
            "status": 404
          }
        }
      ]
    },
    {
      "name": "done",
      "type": "return",
      "order": 8,
      "isActive": true,
      "config": {
        "value": {
          "deleted": true,
          "petId": "{{record.petId}}"
        }
      }
    }
  ],
  "stopOnError": true,
  "timeoutSec": 30,
  "outputFields": [],
  "runInTransaction": true
}
