{
  "selectField": {
    "formKey": "productId",
    "type": "select",
    "optionsSource": "schema",
    "sourceSchemaName": "product",
    "sourceValueField": "_id",
    "sourceLabelField": "name",
    "sourceDataFields": [
      "name",
      "price"
    ],
    "optionDisplay": {
      "leftTemplate": "{{name}}",
      "rightTemplate": "{{price}} ₺"
    }
  },
  "objectList": {
    "key": "items",
    "itemFields": [
      "productId",
      "quantity"
    ],
    "mergeOnAdd": {
      "matchField": "productId",
      "quantityField": "quantity"
    },
    "fieldMappings": [
      {
        "sourceFormKey": "productId",
        "sourceField": "price",
        "targetField": "unitPrice",
        "required": true
      }
    ],
    "itemCalculations": [
      {
        "operation": "quantityDiscount",
        "inputs": [
          "unitPrice",
          "quantity"
        ],
        "originalTargetField": "originalLineTotal",
        "targetField": "lineTotal",
        "discountTiers": [
          {
            "minimumQuantity": 6,
            "discountPercentage": 30
          },
          {
            "minimumQuantity": 10,
            "discountPercentage": 40
          }
        ],
        "precision": 2
      }
    ],
    "display": {
      "primaryField": "productId",
      "secondaryTemplate": "{{quantity}} adet · {{unitPrice}} TRY",
      "rightTemplate": "{{lineTotal}} TRY",
      "priceComparison": {
        "originalField": "originalLineTotal",
        "discountedField": "lineTotal",
        "currency": "TRY",
        "precision": 2
      }
    }
  },
  "summaries": [
    {
      "key": "subtotal",
      "label": "Ara Toplam",
      "area": "right",
      "order": 1,
      "operation": "sum",
      "objectListKey": "items",
      "sourceField": "lineTotal",
      "targetField": "subtotal",
      "format": {
        "style": "currency",
        "currency": "TRY",
        "precision": 2
      }
    },
    {
      "key": "total",
      "label": "Toplam",
      "area": "right",
      "order": 2,
      "operation": "copy",
      "sourceField": "subtotal",
      "targetField": "total",
      "format": {
        "style": "currency",
        "currency": "TRY",
        "precision": 2
      }
    }
  ]
}
