# Development only. Copy to .env with mode 0600; never commit real credentials.
# The application loads .env itself. Do not execute this file as a shell script.
NODE_ENV=development
PORT_NUMBER=4000

# Use a dedicated LOCAL Mongo replica set; transactions require a replica set.
MONGO_URI_BASE=mongodb://127.0.0.1:27017/
COLLECTION_NAME=autotable_development
MONGO_URI_SUFFIX=?replicaSet=autotable-dev&retryWrites=true&w=majority
# Redis address/pool settings and CORS are in configs/development.json.
REDIS_PASSWORD=

# REQUIRED: paste independent values from `make secrets`. Empty is fail-closed.
JWT_SECRET=
TENANT_JWT_SECRET=
# Optional legacy key: leave unset unless needed; if supplied it must be strong/distinct.
CONTAINER_JWT_SECRET=

# Optional dedicated random diagnostics key. Empty disables metrics.
OBSERVABILITY_TOKEN=
ENABLE_PPROF=false
OTEL_TRACING_ENABLED=false
OTEL_SERVICE_NAME=autotable-go
OTEL_EXPORTER_OTLP_ENDPOINT=127.0.0.1:4317
LOG_LEVEL=info
LOG_FILE=logs/autotable.log

# Optional external API credential encryption: independent `openssl rand -base64 32`.
# Required by the production release workflow; never rotate without a data/key plan.
EXTERNAL_API_CREDENTIAL_KEY=

# Optional customer integrations; configure only the features you use.
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:4000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3001
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=

# Collaboration invitations/recovery require the documented HTTPS/SMTP/keyring setup.
COLLABORATION_MEMBERS_ENABLED=false
COLLABORATION_INVITATIONS_ENABLED=false
COLLABORATION_RECOVERY_ENABLED=false
INVITATION_SMTP_HOST=
INVITATION_SMTP_PORT=587
INVITATION_SMTP_TLS_MODE=starttls
INVITATION_SMTP_FROM=
INVITATION_SMTP_USERNAME=
INVITATION_SMTP_PASSWORD=
INVITATION_PANEL_URL=
INVITATION_DELIVERY_KEYS_JSON=
INVITATION_DELIVERY_ACTIVE_KEY_ID=

# Optional Ozmishow limiter: independent service keys and a separate protected Redis.
OZMISHOW_RATE_LIMIT_SERVICE_SECRET=
OZMISHOW_RATE_LIMIT_PREVIOUS_SECRET=
OZMISHOW_RATE_LIMIT_REDIS_ADDR=
OZMISHOW_RATE_LIMIT_REDIS_PASSWORD=
OZMISHOW_RATE_LIMIT_NAMESPACE=ozmishow
